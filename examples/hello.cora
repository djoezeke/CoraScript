import io

io.print("-- for-range demo --")
int sum = 0
for i in range(0, 10, 2):
    if i == 6:
        continue
    sum = sum + i
io.print("sum=" + sum)

io.print("-- c-style for demo --")
for (int j = 0; j < 5; j = j + 1) {
    if j == 3 {
        break;
    }
    pass;
    io.print("j=" + j);
}
