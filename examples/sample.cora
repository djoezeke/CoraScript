# Mixed C/Python-style syntax demo

int n = 6
int result = 1

while n > 1:
    result = result * n
    n = n - 1

if result > 100 {
    print("factorial=" + result);
} else:
    print("small")

let is_big = result >= 720 and true
print("is_big=" + is_big)

print("-- for-range demo --")
int sum = 0
for i in range(0, 10, 2):
    if i == 6:
        continue
    sum = sum + i
print("sum=" + sum)

print("-- c-style for demo --")
for (int j = 0; j < 5; j = j + 1) {
    if j == 3 {
        break;
    }
    pass;
    print("j=" + j);
}

print("-- extended syntax demo --")
let empty_value = none
print("null-value:", empty_value)

int total = 0
for k in range(5):
    total = total + k
print("range(5) total:", total)
