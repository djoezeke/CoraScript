print("-- class syntax demo --")

class Person:
    fun __init__(name, age):
        this.set("name", name)
        this.set("age", age)

    fun greet(prefix):
        return prefix + " " + this.get("name")

    fun __del__():
        print("destroying", this.get("name"))

let p = new Person("Zeke", int(29.8))
print("name:", p.get("name"))
print("age:", p.get("age"))
print("greet:", p.greet("Hello"))

delete p
print("class demo done")
